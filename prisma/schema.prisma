generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id          String       @id @default(uuid())
  name        String
  supervisors Supervisor[]
}

model PageContent {
  id        String   @id @default("singleton")
  content   String
  updatedAt DateTime @updatedAt

  @@map("page_content")
}

model GuideContent {
  id        String   @id @default("singleton")
  content   String   // JSON: { intro?, sections: GuideSection[] }
  updatedAt DateTime @updatedAt

  @@map("guide_content")
}

model Supervisor {
  id           String    @id @default(uuid())
  name         String
  position     String?
  rank         String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  exhibits     Exhibit[]

  @@index([name])
  @@index([departmentId])
}

model Student {
  id        String    @id @default(uuid())
  name      String
  course    Int?
  groupCode String?
  exhibits  Exhibit[]

  @@index([name])
}

model Category {
  id       String   @id @default(uuid())
  name     String
  exhibits Exhibit[]

  @@unique([name])
  @@index([name])
}

model Exhibit {
  id              String    @id @default(uuid())
  inventoryNumber String?   @unique
  title           String
  description     String
  fullDescription String?   @default("")
  creationDate    String?
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  studentId       String?
  student         Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  supervisorId    String?
  supervisor      Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  dimensions      String?
  currentLocation String?
  isPublic        Boolean   @default(true)
  technicalSpecs  String?   @default("{}")
  interestingFacts String?  @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mediaResources   MediaResource[]
  gallerySettings  GallerySettings?

  @@index([categoryId])
  @@index([studentId])
  @@index([supervisorId])
  @@index([isPublic])
}

model MediaResource {
  id        String  @id @default(uuid())
  exhibitId String
  exhibit   Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  filePath  String
  fileType  String  // "image" | "video" | "model"
  isPrimary Boolean @default(false)

  @@index([exhibitId])
}

model GallerySettings {
  id               String   @id @default(uuid())
  exhibitId        String   @unique
  exhibit          Exhibit  @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  posX             Float?
  posY             Float?
  posZ             Float?
  scale            Float?   @default(1.0)
  rotY             Float?   @default(0)
  visibleInGallery Boolean  @default(true)

  @@index([exhibitId])
}
